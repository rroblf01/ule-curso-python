---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';

interface Props {
	title: string;
	description?: string;
	currentDay?: number;
}

const {
	title,
	description = 'Curso introductorio de Python en 3 días para estudiantes de primer curso de la Universidad de León.',
	currentDay,
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			// Hosts that cannot send COOP/COEP headers (e.g. GitHub Pages): add them with a service worker.
			if (!window.crossOriginIsolated && window.isSecureContext && 'serviceWorker' in navigator) {
				const coi = document.createElement('script');
				coi.src = '/mini-coi.js';
				document.head.append(coi);
			}
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title} · Python en 3 días</title>
		<script is:inline>
			try {
				const saved = localStorage.getItem('theme');
				if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
			} catch {}
		</script>
	</head>
	<body>
		<Navbar currentDay={currentDay} />
		<slot />
	</body>
</html>
