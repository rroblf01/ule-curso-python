---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';

interface Props {
	title: string;
	description?: string;
	currentDay?: number;
	/** Highlight the Playground link in the navbar. */
	playground?: boolean;
}

const {
	title,
	description = 'Curso introductorio de Python en 3 días para estudiantes de primer curso de la Universidad de León.',
	currentDay,
	playground = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			// Hosts that cannot send COOP/COEP headers (e.g. GitHub Pages): add them with a service worker.
			if (!window.crossOriginIsolated && window.isSecureContext && 'serviceWorker' in navigator) {
				const coi = document.createElement('script');
				coi.src = '/mini-coi.js';
				document.head.append(coi);
			}
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title} · Python en 3 días</title>
		<script is:inline>
			// Restore the theme on first load and after every client-side navigation
			// (the router replaces the attributes of <html>).
			(() => {
				const applyTheme = () => {
					try {
						const saved = localStorage.getItem('theme');
						if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
					} catch {}
				};
				applyTheme();
				document.addEventListener('astro:after-swap', applyTheme);
			})();
		</script>
		<!-- Navigating without full page reloads keeps the Python worker alive between pages. -->
		<ClientRouter />
	</head>
	<body>
		<Navbar currentDay={currentDay} playground={playground} />
		<slot />
		<script>
			import { startPythonSoon } from '../scripts/python/preload';

			startPythonSoon();
		</script>
	</body>
</html>
