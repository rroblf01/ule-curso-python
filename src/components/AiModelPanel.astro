---
import { AI_DEFAULTS } from '../data/ai';
---

<section class="ai-panel" data-ai-panel aria-label="Modelo de IA">
	<p class="title">Modelo de IA</p>
	<label>
		<span>Servidor Ollama</span>
		<input
			type="url"
			data-ai-server
			value={AI_DEFAULTS.server}
			spellcheck="false"
			autocomplete="off"
			placeholder="http://localhost:11434"
		/>
	</label>
	<label>
		<span>Modelo</span>
		<div class="row">
			<select data-ai-model>
				<option value={AI_DEFAULTS.model}>{AI_DEFAULTS.model}</option>
			</select>
			<button type="button" data-ai-refresh title="Volver a consultar los modelos del servidor" aria-label="Actualizar">
				<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M20 4v6h-6M19.5 15a8 8 0 1 1-1.9-8.3L20 10"></path>
				</svg>
			</button>
		</div>
	</label>
	<p class="msg" data-ai-msg role="status"></p>
	<button type="button" class="reset" data-ai-reset hidden>Volver al modelo del curso</button>
</section>

<style>
	.ai-panel {
		margin-top: 12px;
		padding: 12px 14px;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--surface-2);
		font-size: 0.85rem;
	}

	.title {
		margin: 0 0 8px;
		font-weight: 600;
	}

	label {
		display: block;
		margin-bottom: 8px;
	}

	label > span {
		display: block;
		margin-bottom: 3px;
		color: var(--muted);
		font-size: 0.78rem;
	}

	input,
	select {
		width: 100%;
		min-width: 0;
		padding: 5px 8px;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: var(--surface);
		color: var(--text);
		font: 0.82rem var(--mono);
	}

	input:focus,
	select:focus {
		outline: 2px solid var(--accent);
		outline-offset: 0;
	}

	.row {
		display: flex;
		gap: 6px;
	}

	button {
		border: 1px solid var(--border);
		border-radius: 6px;
		background: var(--surface);
		color: var(--text);
		cursor: pointer;
	}

	button:hover {
		border-color: var(--accent);
	}

	[data-ai-refresh] {
		display: grid;
		place-items: center;
		flex: none;
		width: 30px;
	}

	.msg {
		margin: 0;
		color: var(--muted);
		font-size: 0.78rem;
		line-height: 1.4;
	}

	.msg[data-state='ok'] {
		color: var(--success);
	}

	.msg[data-state='error'] {
		color: var(--error);
	}

	.reset {
		margin-top: 8px;
		padding: 4px 10px;
		border-radius: 999px;
		font: 600 0.78rem var(--font);
	}
</style>
