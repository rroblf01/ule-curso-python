---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PythonStatus from '../../components/PythonStatus.astro';
import { days } from '../../data/days';
import '../../styles/playground.css';

export function getStaticPaths() {
	return days.map((day) => ({ params: { day: String(day.number) }, props: { day } }));
}

const { day } = Astro.props;

const entries = (await getCollection('lessons', (entry) => entry.data.day === day.number)).sort(
	(a, b) => a.data.order - b.data.order,
);

const lessons = await Promise.all(
	entries.map(async (entry) => ({
		slug: entry.id.split('/').pop()!.replace(/^\d+-/, ''),
		data: entry.data,
		Content: (await render(entry)).Content,
	})),
);

const totalMinutes = lessons.reduce((sum, lesson) => sum + lesson.data.minutes, 0);
const hasRunnable = lessons.some((lesson) => lesson.data.runnable);
---

<Base title={`Día ${day.number}: ${day.title}`} description={day.goal} currentDay={day.number}>
	<main class="layout" data-lessons>
		<aside class="sidebar">
			<p class="eyebrow">Día {day.number} · {totalMinutes} min</p>
			<h1>{day.title}</h1>
			<p class="goal">{day.goal}</p>
			<ol class="topics">
				{
					lessons.map((lesson, i) => (
						<li>
							<a href={`#${lesson.slug}`} data-topic={lesson.slug}>
								<span class="num">{i + 1}</span>
								<span class="name">{lesson.data.title}</span>
								<span class="mins">{lesson.data.minutes}′</span>
							</a>
						</li>
					))
				}
			</ol>
			{hasRunnable && <PythonStatus />}
		</aside>

		<div class="content">
			{
				lessons.map((lesson, i) => (
					<article
						class="lesson"
						id={lesson.slug}
						data-lesson={lesson.slug}
						data-runnable={lesson.data.runnable ? '' : undefined}
					>
						<p class="eyebrow">
							Tema {i + 1} de {lessons.length} · {lesson.data.minutes} min
						</p>
						<h2 class="lesson-title">{lesson.data.title}</h2>
						<div class="prose">
							<lesson.Content />
						</div>
						<nav class="pager" aria-label="Navegación entre temas">
							{i > 0 ? (
								<a href={`#${lessons[i - 1].slug}`} class="prev">
									<small>Anterior</small>
									{lessons[i - 1].data.title}
								</a>
							) : (
								<span />
							)}
							{i < lessons.length - 1 ? (
								<a href={`#${lessons[i + 1].slug}`} class="next">
									<small>Siguiente</small>
									{lessons[i + 1].data.title}
								</a>
							) : day.number < days.length ? (
								<a href={`/dia/${day.number + 1}/`} class="next">
									<small>Siguiente día</small>
									Día {day.number + 1}: {days[day.number].title}
								</a>
							) : (
								<span />
							)}
						</nav>
					</article>
				))
			}
		</div>
	</main>
</Base>

<script>
	import { bootPythonWhenIdle, isRunnableBlock, mountPlaygrounds, mountStatusPanel } from '../../scripts/python';

	const root = document.querySelector<HTMLElement>('[data-lessons]')!;
	const lessons = [...root.querySelectorAll<HTMLElement>('[data-lesson]')];
	const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-topic]')];
	const content = root.querySelector<HTMLElement>('.content')!;

	root.classList.add('js');

	function show(slug: string, scroll: boolean) {
		const target = lessons.find((l) => l.dataset.lesson === slug) ?? lessons[0];
		for (const lesson of lessons) lesson.hidden = lesson !== target;
		mountPlaygrounds(target);
		for (const link of links) {
			const active = link.dataset.topic === target.dataset.lesson;
			link.classList.toggle('active', active);
			if (active) link.setAttribute('aria-current', 'true');
			else link.removeAttribute('aria-current');
		}
		if (scroll) {
			const top = content.getBoundingClientRect().top + window.scrollY - 80;
			window.scrollTo({ top: Math.max(0, Math.min(window.scrollY, top)) });
		}
	}

	const statusPanel = root.querySelector<HTMLElement>('[data-python-status]');
	if (statusPanel) {
		mountStatusPanel(statusPanel);
		bootPythonWhenIdle();
	}

	show(decodeURIComponent(location.hash.slice(1)), false);
	window.addEventListener('hashchange', () => show(decodeURIComponent(location.hash.slice(1)), true));

	// Copy button for every static code block (runnable ones become editors)
	for (const pre of root.querySelectorAll<HTMLPreElement>('pre')) {
		if (isRunnableBlock(pre)) continue;
		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'copy';
		button.textContent = 'Copiar';
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
				button.textContent = '¡Copiado!';
			} catch {
				button.textContent = 'Error';
			}
			setTimeout(() => (button.textContent = 'Copiar'), 1500);
		});
		const wrapper = document.createElement('div');
		wrapper.className = 'code-wrapper';
		pre.replaceWith(wrapper);
		wrapper.append(pre, button);
	}
</script>

<style>
	.layout {
		max-width: 1280px;
		margin: 0 auto;
		padding: 24px 16px 64px;
		display: grid;
		grid-template-columns: 320px minmax(0, 1fr);
		gap: 32px;
		align-items: start;
	}

	.sidebar {
		position: sticky;
		top: calc(var(--nav-h) + 24px);
		max-height: calc(100vh - var(--nav-h) - 48px);
		overflow-y: auto;
		padding: 20px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}

	.eyebrow {
		margin: 0;
		color: var(--muted);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.sidebar h1 {
		margin: 4px 0 8px;
		font-size: 1.3rem;
		line-height: 1.3;
	}

	.goal {
		margin: 0 0 16px;
		color: var(--muted);
		font-size: 0.92rem;
		line-height: 1.5;
	}

	.topics {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 2px;
	}

	.topics a {
		display: grid;
		grid-template-columns: 26px 1fr auto;
		align-items: center;
		gap: 10px;
		padding: 8px 10px;
		border-radius: 8px;
		color: var(--text);
		text-decoration: none;
		font-size: 0.95rem;
		line-height: 1.35;
	}

	.topics a:hover {
		background: var(--surface-2);
	}

	.topics a.active {
		background: var(--accent);
		color: var(--accent-contrast);
	}

	.num {
		display: grid;
		place-items: center;
		width: 26px;
		height: 26px;
		border-radius: 999px;
		background: var(--surface-2);
		color: var(--muted);
		font-size: 0.8rem;
		font-weight: 700;
	}

	.active .num {
		background: var(--yellow);
		color: #1c2430;
	}

	.mins {
		color: var(--muted);
		font-size: 0.8rem;
		font-variant-numeric: tabular-nums;
	}

	.active .mins {
		color: inherit;
		opacity: 0.85;
	}

	.content {
		min-width: 0;
	}

	.lesson {
		padding: 32px 40px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}

	.layout:not(.js) .lesson + .lesson {
		margin-top: 24px;
	}

	.lesson-title {
		margin: 4px 0 20px;
		font-size: 2rem;
		line-height: 1.2;
	}

	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px;
		margin-top: 40px;
		padding-top: 24px;
		border-top: 1px solid var(--border);
	}

	.pager a {
		display: flex;
		flex-direction: column;
		padding: 12px 16px;
		border: 1px solid var(--border);
		border-radius: 10px;
		color: var(--text);
		text-decoration: none;
		font-weight: 600;
	}

	.pager a:hover {
		border-color: var(--accent);
	}

	.pager small {
		color: var(--muted);
		font-weight: 500;
	}

	.pager .next {
		grid-column: 2;
		text-align: right;
	}

	@media (max-width: 900px) {
		.layout {
			grid-template-columns: minmax(0, 1fr);
			gap: 16px;
		}
		.sidebar {
			position: static;
			max-height: none;
		}
		.lesson {
			padding: 24px 18px;
		}
		.lesson-title {
			font-size: 1.6rem;
		}
	}

	/* ---------- Lesson prose (rendered Markdown) ---------- */
	.prose :global(h2) {
		margin: 2em 0 0.6em;
		font-size: 1.35rem;
	}

	.prose :global(h3) {
		margin: 1.6em 0 0.5em;
		font-size: 1.1rem;
	}

	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 1em;
	}

	.prose :global(li + li) {
		margin-top: 0.25em;
	}

	.prose :global(:not(pre) > code) {
		padding: 0.12em 0.4em;
		border-radius: 6px;
		background: var(--surface-2);
		font-size: 0.88em;
	}

	.prose :global(.code-wrapper) {
		position: relative;
		margin: 0 0 1.2em;
	}

	.prose :global(pre) {
		margin: 0;
		padding: 16px 18px;
		border: 1px solid var(--border);
		border-radius: 10px;
		overflow-x: auto;
		font-size: 0.9rem;
		line-height: 1.55;
	}

	.prose :global(.copy) {
		position: absolute;
		top: 8px;
		right: 8px;
		padding: 3px 10px;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: var(--surface);
		color: var(--muted);
		font: 600 0.75rem var(--font);
		cursor: pointer;
		opacity: 0;
		transition: opacity 0.15s;
	}

	.prose :global(.code-wrapper:hover .copy),
	.prose :global(.copy:focus-visible) {
		opacity: 1;
	}

	@media (hover: none) {
		.prose :global(.copy) {
			opacity: 1;
		}
	}

	.prose :global(blockquote) {
		margin: 0 0 1.2em;
		padding: 12px 16px;
		border-left: 4px solid var(--tip-border);
		border-radius: 0 10px 10px 0;
		background: var(--tip-bg);
	}

	.prose :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	.prose :global(table) {
		width: 100%;
		margin: 0 0 1.2em;
		border-collapse: collapse;
		font-size: 0.95rem;
		display: block;
		overflow-x: auto;
	}

	.prose :global(th),
	.prose :global(td) {
		padding: 8px 12px;
		border-bottom: 1px solid var(--border);
		text-align: left;
		vertical-align: top;
	}

	.prose :global(th) {
		background: var(--surface-2);
	}

	.prose :global(details) {
		margin: 0 0 1.2em;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--surface-2);
	}

	.prose :global(summary) {
		padding: 10px 14px;
		cursor: pointer;
		font-weight: 600;
		color: var(--accent);
	}

	.prose :global(details[open] summary) {
		border-bottom: 1px solid var(--border);
	}

	.prose :global(details > :not(summary)) {
		margin: 12px 14px;
	}

	.prose :global(img) {
		max-width: 100%;
		height: auto;
	}

	.prose :global(hr) {
		margin: 2em 0;
		border: 0;
		border-top: 1px solid var(--border);
	}
</style>
