---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { days } from '../data/days';

const lessons = await getCollection('lessons');

const summary = days.map((day) => {
	const dayLessons = lessons
		.filter((lesson) => lesson.data.day === day.number)
		.sort((a, b) => a.data.order - b.data.order);
	return {
		...day,
		topics: dayLessons.map((lesson) => lesson.data.title),
		minutes: dayLessons.reduce((sum, lesson) => sum + lesson.data.minutes, 0),
	};
});
---

<Base title="Inicio">
	<main class="home">
		<section class="hero">
			<p class="eyebrow">Universidad de León · Curso introductorio</p>
			<h1>Aprende <span class="py">Python</span> en 3 días</h1>
			<p class="lead">
				Desde tu primer <code>print("Hello world")</code> hasta construir un asistente de estudio con
				inteligencia artificial que resume tus apuntes y te hace tests. Todos los ejemplos se pueden editar y
				ejecutar aquí mismo, en el navegador.
			</p>
			<div class="actions">
				<a class="btn primary" href="/dia/1/">Empezar por el día 1</a>
				<a class="btn" href="/dia/1/#entorno">Cómo funcionan los editores</a>
			</div>
		</section>

		<section class="days" aria-label="Días del curso">
			{
				summary.map((day) => (
					<a class="card" href={`/dia/${day.number}/`}>
						<div class="card-head">
							<span class="badge">Día {day.number}</span>
							<span class="time">{day.minutes} min</span>
						</div>
						<h2>{day.title}</h2>
						<p class="subtitle">{day.subtitle}</p>
						<ul>
							{day.topics.map((topic) => (
								<li>{topic}</li>
							))}
						</ul>
						<span class="go">Ver contenido →</span>
					</a>
				))
			}
		</section>

		<section class="info">
			<div>
				<h2>Sin instalar nada</h2>
				<p>
					Python se ejecuta en tu navegador gracias a <a href="https://pyscript.net" target="_blank" rel="noopener">PyScript</a>.
					El día 3 usaremos <a href="https://colab.research.google.com" target="_blank" rel="noopener">Google Colab</a>
					para tener una GPU con la que ejecutar un modelo de IA.
				</p>
			</div>
			<div>
				<h2>Cómo usar esta web</h2>
				<p>
					Elige el día en la barra superior y pulsa un tema a la izquierda. Cada bloque de código es un editor:
					cámbialo, ejecútalo y aprovecha el autocompletado y los errores explicados en español.
				</p>
			</div>
			<div>
				<h2>Practica</h2>
				<p>
					Cada día incluye ejercicios con la solución oculta. Intenta resolverlos antes de mirarla: equivocarse es
					la mejor forma de aprender a programar.
				</p>
			</div>
		</section>
	</main>
</Base>

<style>
	.home {
		max-width: 1280px;
		margin: 0 auto;
		padding: 48px 16px 72px;
	}

	.hero {
		max-width: 760px;
		margin-bottom: 48px;
	}

	.eyebrow {
		margin: 0 0 8px;
		color: var(--muted);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0 0 16px;
		font-size: clamp(2.2rem, 6vw, 3.6rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
	}

	.py {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-color: var(--yellow);
		text-decoration-thickness: 0.12em;
		text-underline-offset: 0.12em;
	}

	.lead {
		margin: 0 0 24px;
		color: var(--muted);
		font-size: 1.15rem;
	}

	.lead code {
		padding: 0.1em 0.35em;
		border-radius: 6px;
		background: var(--surface-2);
		color: var(--text);
		font-size: 0.9em;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.btn {
		padding: 11px 20px;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface);
		color: var(--text);
		font-weight: 600;
		text-decoration: none;
	}

	.btn:hover {
		border-color: var(--accent);
	}

	.btn.primary {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--accent-contrast);
	}

	.days {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 20px;
		margin-bottom: 48px;
	}

	.card {
		display: flex;
		flex-direction: column;
		padding: 24px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		color: var(--text);
		text-decoration: none;
		transition: border-color 0.15s, transform 0.15s;
	}

	.card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}

	.card-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.badge {
		padding: 3px 12px;
		border-radius: 999px;
		background: var(--yellow);
		color: #1c2430;
		font-size: 0.85rem;
		font-weight: 700;
	}

	.time {
		color: var(--muted);
		font-size: 0.85rem;
	}

	.card h2 {
		margin: 14px 0 4px;
		font-size: 1.3rem;
		line-height: 1.3;
	}

	.subtitle {
		margin: 0 0 14px;
		color: var(--muted);
		font-size: 0.95rem;
	}

	.card ul {
		flex: 1;
		margin: 0 0 16px;
		padding-left: 18px;
		font-size: 0.92rem;
		line-height: 1.6;
	}

	.go {
		color: var(--accent);
		font-weight: 600;
	}

	.info {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 20px;
	}

	.info div {
		padding: 20px 24px;
		border-radius: var(--radius);
		background: var(--surface-2);
	}

	.info h2 {
		margin: 0 0 8px;
		font-size: 1.05rem;
	}

	.info p {
		margin: 0;
		color: var(--muted);
		font-size: 0.95rem;
	}
</style>
